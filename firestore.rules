rules_version = '2';

// Each signed-in user can read and write only their own data: the users/{uid} document and everything
// under it (predictions, trades, and any collections added later). Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
